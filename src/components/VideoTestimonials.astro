---
import SectionMarker from './SectionMarker.astro';
import { Play } from 'lucide-astro';
import { copy, groups } from '../lib/home';
import ClientBlocks from './ClientBlocks.astro';
const blocks=copy(7);
const content=groups(blocks.slice(1),3);
const qualia=content.groups[0];
const videos=content.groups.slice(1);
---
<section id="testimonios" class="section">
  <SectionMarker index="06" />
  <div class="container">
    <div class="section-heading"><span class="eyebrow">Experiencia en diferentes contextos</span><h2>{blocks[0].text}</h2><ClientBlocks blocks={content.intro} /></div>
    <article class="qualia-case"><h3>{qualia.title}</h3><ClientBlocks blocks={qualia.blocks} /></article>
    <div class="testimonial-grid">
      {videos.map(v=>{const url=v.blocks.find(b=>b.type==='video')?.url!; const videoId=new URL(url).searchParams.get('v');return <article class="testimonial">
        <a class="video-link" href={url} target="_blank" rel="noopener noreferrer" aria-label={`Ver testimonio de ${v.title} en YouTube`}><img src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`} alt={`Testimonio de ${v.title}`} width="480" height="360" loading="lazy" /><span class="video-play"><Play size={18} strokeWidth={1.5} aria-hidden="true" /></span></a>
        <h3>{v.title}</h3><ClientBlocks blocks={v.blocks} />
      </article>;})}
    </div>
  </div>
</section>
