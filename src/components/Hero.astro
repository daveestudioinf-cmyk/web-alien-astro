---
import { ArrowUpRight, ArrowDown, MapPin, Orbit, ScanLine, Check } from 'lucide-astro';
import { copy, cta } from '../lib/home';
const blocks = copy(1);
const paragraphs = blocks.filter(b => b.type === 'paragraph');
const solutions = [
  { label: 'SEO', href: '#seo-geo-aeo' }, { label: 'GEO', href: '#seo-geo-aeo' },
  { label: 'AEO', href: '#seo-geo-aeo' }, { label: 'IA', href: '#ia-automatizacion' },
  { label: 'ADS', href: '#marketing-demanda' }, { label: 'Automatización', href: '#ia-automatizacion' },
  { label: 'CRM', href: '#crm-procesos' }, { label: 'Chatbots', href: '#ia-automatizacion' }
];
---
<section id="inicio" class="hero">
  <div class="hero-atmosphere" aria-hidden="true"><span class="hero-blob hero-blob-large"></span><span class="hero-outline-ring"></span></div>
  <div class="container">
    <div class="hero-topline"><span>Alien Creativo · Marketing de Verdad.</span><span>Medellín y Valle de Aburrá, Colombia</span></div>
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-heading">
        <p class="eyebrow">Marketing · Tecnología · Procesos comerciales</p>
        <h1>Marketing, tecnología y procesos comerciales para <span>crecer</span> con dirección.</h1>
        </div>
        <div class="hero-description">
        <p class="hero-copy">{paragraphs[0].text}</p>
        <p class="hero-copy hero-copy-secondary">{paragraphs[1].text}</p>
        </div>
        <div class="hero-actions">
          <a class="button button-primary" href="#diagnostico">{cta(blocks, 'CTA principal')} <ArrowUpRight size={17} strokeWidth={1.75} /></a>
          <a class="text-link" href="#ia-automatizacion">{cta(blocks, 'CTA secundario')} <ArrowDown size={15} strokeWidth={1.75} /></a>
        </div>
        <p class="hero-note">{paragraphs[2].text}</p>
      </div>
      <div class="hero-art">
        <div class="hero-composition">
          <span class="hero-blob hero-blob-medium" aria-hidden="true"></span>
          <span class="hero-blob hero-blob-small" aria-hidden="true"></span>
          <svg class="hero-rings" viewBox="0 0 560 600" fill="none" aria-hidden="true"><ellipse cx="290" cy="300" rx="225" ry="230" transform="rotate(-22 290 300)" /><ellipse cx="290" cy="300" rx="190" ry="245" transform="rotate(28 290 300)" /></svg>
          <img class="hero-portrait" src="/assets/brand/v4/strategy-portrait-left-1000.webp" srcset="/assets/brand/v4/strategy-portrait-left-600.webp 600w, /assets/brand/v4/strategy-portrait-left-1000.webp 1000w" sizes="(max-width: 700px) calc(100vw - 40px), 50vw" alt="Fotografía conceptual: profesional con ropa beige y portátil, mirando hacia la izquierda, hacia la propuesta de estrategia" width="1000" height="1000" fetchpriority="high" />
          <a class="strategy-card strategy-diagnostic" href="#diagnostico">
            <span class="strategy-card-icon"><ScanLine size={24} strokeWidth={1.75} /></span>
            <span><strong>Primero, claridad.</strong><small>Diagnóstico de tu negocio</small></span>
            <ArrowUpRight size={18} aria-hidden="true" />
          </a>
          <div class="strategy-card strategy-route">
            <strong>Un camino para crecer</strong>
            <p>De entender tu negocio<br />a conectar tus oportunidades.</p>
            <svg viewBox="0 0 240 88" fill="none" role="img" aria-label="Ilustración conceptual de una ruta de crecimiento, sin datos estadísticos">
              <defs><linearGradient id="route-fill" x1="0" y1="0" x2="0" y2="88" gradientUnits="userSpaceOnUse"><stop stop-color="#FF4081" stop-opacity=".35" /><stop offset=".55" stop-color="#FFB6C1" stop-opacity=".18" /><stop offset="1" stop-color="#FFFFFF" stop-opacity="0" /></linearGradient></defs>
              <path d="M8 72C38 72 36 48 66 52S106 67 132 40S171 43 190 22S217 18 232 8V88H8Z" fill="url(#route-fill)" />
              <path class="route-line" d="M8 72C38 72 36 48 66 52S106 67 132 40S171 43 190 22S217 18 232 8" pathLength="1" stroke="#1D2B64" stroke-width="3" stroke-linecap="round" />
              <circle class="route-point" cx="232" cy="8" r="5" fill="#E90064" stroke="#FFFFFF" stroke-width="2" />
            </svg>
            <span class="strategy-route-note"><Check size={14} aria-hidden="true" /> Estrategia antes de ejecutar</span>
          </div>
          <span class="hero-brand-seal" aria-hidden="true"><img src="/assets/brand/alien-symbol.svg" alt="" width="28" height="39" /></span>
        </div>
        <nav class="hero-solutions" aria-label="Explorar soluciones para tu empresa">{solutions.map(solution => <a href={solution.href}>{solution.label}</a>)}</nav>
      </div>
    </div>
    <div class="hero-bottom">
      <span><MapPin size={13} strokeWidth={1.75} /> Medellín y Valle de Aburrá, Colombia</span>
      <span><Orbit size={14} strokeWidth={1.75} /> Personas, procesos, tecnología y datos</span>
      <a class="text-link" href="#casos">Casos y experiencias <ArrowDown size={13} /></a>
    </div>
  </div>
</section>
