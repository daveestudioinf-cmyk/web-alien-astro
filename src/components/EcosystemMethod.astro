---
import SectionMarker from './SectionMarker.astro';
import { UsersRound, Workflow, Cpu, ChartNoAxesCombined, ArrowUpRight } from 'lucide-astro';
import { copy, groups, cta } from '../lib/home';
import ClientBlocks from './ClientBlocks.astro';
const blocks = copy(4);
const content = groups(blocks.slice(1),3);
const icons = [UsersRound,Workflow,Cpu,ChartNoAxesCombined];
const outcome = content.groups[3].blocks.find(b => b.text?.startsWith('Resultado esperado:'));
---
<section id="ecosistema" class="section surface">
  <SectionMarker index="03" />
  <div class="container">
    <div class="brand-section-intro">
      <div class="section-heading"><span class="eyebrow">Un ecosistema, no servicios aislados</span><h2>{blocks[0].text}</h2><ClientBlocks blocks={content.intro} /></div>
      <div class="ecosystem-constellation" aria-hidden="true">
        <svg viewBox="0 0 320 300" fill="none"><circle cx="160" cy="150" r="108" /><circle cx="160" cy="150" r="64" /><path d="M160 42V258M52 150H268" stroke-dasharray="3 7" /></svg>
        <img src="/assets/brand/alien-symbol.svg" alt="" width="46" height="65" loading="lazy" />
        {content.groups.map((p,index)=>{const Icon=icons[index];return <span class={`constellation-point point-${index}`}><Icon size={20} strokeWidth={1.4}/><small>{p.title.replace(/^\d+\. /,'')}</small></span>;})}
      </div>
    </div>
    <div class="pillars">{content.groups.map((p,index)=>{ const Icon=icons[index]; return <article class="pillar"><div style="display:flex;justify-content:space-between"><span class="number">0{index+1}</span><Icon size={23} strokeWidth={1.4} class="quiet-icon" aria-hidden="true" /></div><h3>{p.title.replace(/^\d+\. /,'')}</h3><ClientBlocks blocks={p.blocks.filter(b=>!b.text?.startsWith('Resultado esperado:'))} /></article>; })}</div>
    <div class="inline-callout"><p>{outcome?.text}</p><a href="#diagnostico" class="text-link">{cta(blocks)} <ArrowUpRight size={16} /></a></div>
  </div>
</section>
