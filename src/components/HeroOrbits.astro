---
const labels = [
  { name: 'SEO', pain: '¿No te encuentran?', href: '#seo-geo-aeo' },
  { name: 'GEO', pain: '¿Invisible en la IA?', href: '#seo-geo-aeo' },
  { name: 'AEO', pain: '¿Preguntas sin respuestas?', href: '#seo-geo-aeo' },
  { name: 'IA', pain: '¿Tu equipo no da abasto?', href: '#ia-automatizacion' },
  { name: 'ADS', pain: '¿Clics sin clientes?', href: '#marketing-demanda' },
  { name: 'Automatización', pain: '¿Tareas manuales?', href: '#ia-automatizacion' },
  { name: 'CRM', pain: '¿Contactos sin seguimiento?', href: '#crm-procesos' },
  { name: 'Chatbots', pain: '¿Mensajes sin responder?', href: '#ia-automatizacion' }
];
const tilt = -18 * Math.PI / 180;
function position(index: number) {
  const angle = index * Math.PI / 4;
  const x = 41 * Math.sin(angle), y = -41 * Math.cos(angle);
  return { x: x * Math.cos(tilt) - y * Math.sin(tilt), y: x * Math.sin(tilt) + y * Math.cos(tilt) };
}
---
<div class="hero-orbits">
  <svg class="orbit-saucer" viewBox="0 0 600 600" fill="none" aria-hidden="true">
    <circle cx="300" cy="300" r="246" />
    <circle cx="300" cy="300" r="198" />
    <circle cx="300" cy="300" r="144" />
  </svg>
  <div class="orbit-links" role="group" aria-label="Encuentra una solución para los desafíos de tu empresa">
    {labels.map((label,index)=>{const p=position(index);return <div class="orbit-node" style={`left:${50+p.x}%;top:${50+p.y}%`}>
      <a class="orbit-label" href={label.href} aria-label={`${label.name}: explorar soluciones`}>
        <svg class="orbit-craft" viewBox="0 0 160 96" preserveAspectRatio="none" fill="none" aria-hidden="true">
          <path class="craft-dome" d="M48 34C50 3 110 3 112 34Z" />
          <ellipse class="craft-hull" cx="80" cy="57" rx="77" ry="32" />
        </svg>
        <span class="orbit-service">{label.name}</span>
      </a>
    </div>;})}
  </div>
</div>
<script>
  const orbit = document.querySelector<HTMLElement>('.hero-orbits');
  const art = orbit?.closest('.hero-art');
  const animations: Animation[] = [];
  let hovered = art?.matches(':hover') ?? false;
  const tilt = -18 * Math.PI / 180;
  function point(angle: number, width: number, height: number) {
    const x = .41 * width * Math.sin(angle), y = -.41 * height * Math.cos(angle);
    return { x: x * Math.cos(tilt) - y * Math.sin(tilt), y: x * Math.sin(tilt) + y * Math.cos(tilt) };
  }
  function update() {
    if (!orbit) return;
    const playing = !hovered;
    orbit.dataset.playing = String(playing);
    animations.forEach(animation => playing ? animation.play() : animation.pause());
  }
  function build() {
    if(!orbit) return;
    const time = Number(animations[0]?.currentTime ?? 0);
    animations.splice(0).forEach(animation=>animation.cancel());
    const {width,height}=orbit.getBoundingClientRect();
    orbit.querySelectorAll<HTMLElement>('.orbit-node').forEach((node,index)=>{
      const phase=index*Math.PI/4;
      const start=point(phase,width,height);
      node.style.left=`${50+start.x/width*100}%`;
      node.style.top=`${50+start.y/height*100}%`;
      const frames=Array.from({length:97},(_,frame)=>{
        const p=point(phase+frame/96*2*Math.PI,width,height);
        return {transform:`translate(-50%, -50%) translate(${p.x-start.x}px, ${p.y-start.y}px)`};
      });
      const animation=node.animate(frames,{duration:64000,iterations:Infinity,easing:'linear'});
      animation.pause();
      animation.currentTime=time;
      animations.push(animation);
    });
    update();
  }
  if(orbit){
    build();
    new ResizeObserver(build).observe(orbit);
    art?.addEventListener('pointerenter',event=>{hovered=(event as PointerEvent).pointerType==='mouse';update();});
    art?.addEventListener('pointerleave',()=>{hovered=false;update();});
  }
</script>
