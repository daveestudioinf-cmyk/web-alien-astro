---
import SectionMarker from './SectionMarker.astro';
import { ArrowUpRight, Plus } from 'lucide-astro';
import { copy, groups, cta } from '../lib/home';
import ClientBlocks from './ClientBlocks.astro';
const blocks = copy(2);
const content = groups(blocks.slice(1),3);
const frictions = content.groups.map((group,index) => ({...group, blocks:index===4?group.blocks.slice(0,2):group.blocks}));
const closing = content.groups[4].blocks.filter(b=>b.type==='paragraph').at(-1);
---
<section id="fricciones" class="section surface">
  <SectionMarker index="01" />
  <div class="container">
    <div class="section-heading"><span class="eyebrow">Identificación del problema</span><h2>{blocks[0].text}</h2><ClientBlocks blocks={content.intro} /></div>
    <div class="friction-list">
      {frictions.map((f,index) => <details class="friction-row" open={index===0}>
        <summary><h3>{f.title}</h3><Plus size={20} aria-hidden="true" /></summary>
        <ClientBlocks blocks={f.blocks} />
      </details>)}
    </div>
    <div class="inline-callout"><p>{closing?.text}</p><a class="text-link" href="#diagnostico">{cta(blocks)} <ArrowUpRight size={17} /></a></div>
  </div>
</section>
