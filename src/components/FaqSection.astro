---
import SectionMarker from './SectionMarker.astro';
import { Plus } from 'lucide-astro';
import { copy,groups } from '../lib/home';
import ClientBlocks from './ClientBlocks.astro';
const faqs=groups(copy(10),2).groups;
---
<section id="faqs" class="section surface">
  <SectionMarker index="09" />
  <div class="container faq-grid">
    <div class="section-heading"><span class="eyebrow">Preguntas frecuentes</span><h2>Preguntas frecuentes</h2></div>
    <div class="faq-list">{faqs.map(faq=><details><summary><span>{faq.title}</span><Plus size={18} strokeWidth={1.3} aria-hidden="true" /></summary><ClientBlocks blocks={faq.blocks} /></details>)}</div>
  </div>
</section>
