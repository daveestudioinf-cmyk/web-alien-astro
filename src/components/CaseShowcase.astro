---
import { ArrowUpRight, Globe, FileText } from 'lucide-astro';
const website = 'https://colorydiseno.co/';
const article = 'https://colorydiseno.co/cuanto-cuesta-corte-laser-textil-precio-b2b/';
---
<div class="case-showcase">
  <figure class="case-website">
    <a class="case-browser" href={website} target="_blank" rel="noopener noreferrer" aria-label="Visitar el sitio web de Color & Diseño, abre en otra pestaña">
      <span class="case-browser-bar">
        <span class="browser-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>colorydiseno.co</span>
        <ArrowUpRight size={15} strokeWidth={1.5} aria-hidden="true" />
      </span>
      <img src="/assets/cases/colorydiseno-web.webp" alt="Captura real de la web de Color & Diseño, con su identidad visual y sus servicios textiles" width="1440" height="1000" loading="lazy" decoding="async" />
    </a>
    <figcaption><span><Globe size={15} strokeWidth={1.5} aria-hidden="true" /> Sitio web · Color & Diseño</span><a class="text-link" href={website} target="_blank" rel="noopener noreferrer">Visitar proyecto <ArrowUpRight size={15} aria-hidden="true" /></a></figcaption>
  </figure>
  <article class="case-article">
    <a class="case-article-image" href={article} target="_blank" rel="noopener noreferrer" aria-label="Ver el artículo sobre el precio del corte láser textil, abre en otra pestaña">
      <img src="/assets/cases/colorydiseno-articulo-corte-laser.webp" alt="Portada del artículo de Color & Diseño sobre el costo del corte láser textil para empresas" width="900" height="514" loading="lazy" decoding="async" />
    </a>
    <div class="case-article-copy">
      <span class="case-work-label"><FileText size={14} strokeWidth={1.5} aria-hidden="true" /> Contenido SEO</span>
      <h3>¿Cuánto Cuesta el Corte Láser Textil? Cómo se Calcula el Precio B2B</h3>
      <a class="text-link" href={article} target="_blank" rel="noopener noreferrer">Leer artículo publicado <ArrowUpRight size={16} aria-hidden="true" /></a>
    </div>
  </article>
</div>
