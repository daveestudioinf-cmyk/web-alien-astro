---
import SectionMarker from './SectionMarker.astro';
import { ArrowUpRight } from 'lucide-astro';
import { copy,cta } from '../lib/home';
import ClientBlocks from './ClientBlocks.astro';
const blocks=copy(11);
const paragraphs=blocks.filter(b=>b.type==='paragraph');
---
<section id="contacto" class="section final-cta">
  <SectionMarker index="10" />
  <div class="container cta-inner">
    <div>
      <span class="eyebrow">Alien Creativo · Marketing de Verdad.</span>
      <h2>{blocks[0].text}</h2>
      <ClientBlocks blocks={paragraphs.slice(0,2)} />
      <div class="hero-actions">
        <a class="button button-primary" href="#diagnostico">{cta(blocks,'CTA principal')} <ArrowUpRight size={17} /></a>
        <a class="text-link" href="https://wa.me/573053552822" target="_blank" rel="noopener noreferrer">{cta(blocks,'CTA secundario')} <ArrowUpRight size={16} /></a>
      </div>
      <p class="hero-note">{paragraphs[2].text}</p>
    </div>
    <div class="contact-visual" data-brand-reveal="arrival">
      <span class="brand-art-ring" aria-hidden="true"></span>
      <img class="contact-portrait" src="/assets/brand/v4/listening-portrait-900.webp" srcset="/assets/brand/v4/listening-portrait-500.webp 500w, /assets/brand/v4/listening-portrait-900.webp 900w" sizes="(max-width: 700px) min(360px, calc(100vw - 40px)), 420px" alt="Retrato conceptual de un profesional en actitud de escucha, orientado hacia la invitación a conversar" width="900" height="900" loading="lazy" decoding="async" />
      <div class="contact-conversation-card">
        <div class="contact-card-brand"><img src="/assets/brand/alien-symbol.svg" alt="" width="20" height="28" loading="lazy" aria-hidden="true" /><span>Alien Creativo</span></div>
        <p class="contact-card-title">Primero, entendamos tu negocio</p>
        <p class="contact-card-copy">Conversemos sobre dónde estás y qué necesitas mejorar.</p>
      </div>
    </div>
  </div>
</section>
