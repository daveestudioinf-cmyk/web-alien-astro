---
interface Props {
  scene: 'hero' | 'diagnostic' | 'automation' | 'advisory';
  alt: string;
  priority?: boolean;
  class?: string;
}
const { scene, alt, priority = false, class: className = '' } = Astro.props;
const base = scene === 'hero'
  ? '/assets/brand/v3/photography/hero'
  : `/assets/brand/v4/photography/${scene}`;
---
<img
  class={`concept-photo ${className}`}
  src={`${base}-1200.webp`}
  srcset={`${base}-600.webp 600w, ${base}-1200.webp 1200w`}
  sizes={priority ? '(max-width: 700px) calc(100vw - 40px), 1200px' : '(max-width: 700px) calc(100vw - 40px), (max-width: 1100px) 50vw, 600px'}
  width="1200" height="800" alt={alt}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'} decoding="async"
/>
