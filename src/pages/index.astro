---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

import ProblemFrictions from '../components/ProblemFrictions.astro';
import DigitalDiagnostic from '../components/DigitalDiagnostic.astro';
import EcosystemMethod from '../components/EcosystemMethod.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import CaseStudyColorDiseno from '../components/CaseStudyColorDiseno.astro';
import VideoTestimonials from '../components/VideoTestimonials.astro';
import MethodologySteps from '../components/MethodologySteps.astro';
import TransparencyManifesto from '../components/TransparencyManifesto.astro';
import FaqSection from '../components/FaqSection.astro';
import FinalCta from '../components/FinalCta.astro';

import { meta } from '../lib/home';
import { seoSchema } from '../lib/seo';
const jsonLd = seoSchema;
---
<Layout title={meta.title} description={meta.description} canonical={meta.canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Hero />

  <ProblemFrictions />
  <DigitalDiagnostic />
  <EcosystemMethod />
  <ServicesGrid />
  <CaseStudyColorDiseno />
  <VideoTestimonials />
  <MethodologySteps />
  <TransparencyManifesto />
  <FaqSection />
  <FinalCta />
</Layout>

