---
import SectionMarker from './SectionMarker.astro';
import { ArrowUpRight, MessagesSquare, ScanLine, ListOrdered, Workflow, ChartNoAxesCombined } from 'lucide-astro';
import { copy,groups,cta } from '../lib/home';
import ClientBlocks from './ClientBlocks.astro';
const blocks=copy(8);
const content=groups(blocks.slice(1),3);
const icons=[MessagesSquare,ScanLine,ListOrdered,Workflow,ChartNoAxesCombined];
---
<section id="metodologia" class="section surface">
  <SectionMarker index="07" />
  <div class="container">
    <div class="mission-journey">
      <div class="mission-intro">
        <div class="section-heading"><span class="eyebrow">Metodología de trabajo</span><h2>{blocks[0].text}</h2><ClientBlocks blocks={content.intro} /></div>
        <a href="#diagnostico" class="button button-primary">{cta(blocks)} <ArrowUpRight size={17} /></a>
        <div class="mission-brand"><img src="/assets/brand/alien-symbol.svg" alt="" width="24" height="34" loading="lazy" aria-hidden="true" /><span>Alien Creativo · Marketing de Verdad.</span></div>
      </div>
      <div class="mission-route">
      <ol class="mission-steps" aria-label="Las cinco etapas de nuestra metodología">
        {content.groups.map((s,index)=>{const Icon=icons[index];return <li class="mission-step" data-stage={index} aria-current={index===0?'step':undefined}>
          {index !== content.groups.length - 1 && <svg class="mission-connector" viewBox="0 0 56 100" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M28 0C4 30 52 70 28 100" vector-effect="non-scaling-stroke" /></svg>}
          <span class="mission-node" aria-hidden="true"><Icon size={24} strokeWidth={1.5} /></span>
          <article><div class="mission-step-title"><h3>{s.title.replace(/^\d+\. /,'')}</h3></div><ClientBlocks blocks={s.blocks} /></article>
        </li>;})}
      </ol>
      <span class="mission-vessel" aria-hidden="true" hidden><svg viewBox="0 0 32 24" fill="none"><path d="M10 10C11 2 21 2 22 10M3 13Q16 4 29 13Q16 23 3 13Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
      </div>
    </div>
  </div>
</section>
<script>
  const journey=document.querySelector<HTMLElement>('.mission-journey');
  if(journey){
    const list=journey.querySelector<HTMLElement>('.mission-steps')!;
    const steps=[...journey.querySelectorAll<HTMLElement>('.mission-step')];
    const route=journey.querySelector<HTMLElement>('.mission-route')!;
    const paths=[...journey.querySelectorAll<SVGPathElement>('.mission-connector path')];
    const vessel=journey.querySelector<HTMLElement>('.mission-vessel')!;
    let scheduled=false, visible=false;
    function update(){
      scheduled=false;
      const listTop=list.getBoundingClientRect().top;
      const centers=steps.map(step=>{const r=step.querySelector('.mission-node')!.getBoundingClientRect();return r.top+r.height/2-listTop;});
      const readingPosition=innerHeight*.42-listTop;
      let active=0;
      centers.forEach((center,index)=>{if(center<=readingPosition)active=index;});
      steps.forEach((step,index)=>{
        if(index===active)step.setAttribute('aria-current','step');else step.removeAttribute('aria-current');
      });
      const path=paths[Math.min(active,paths.length-1)];
      const matrix=path?.getScreenCTM();
      if(!matrix){vessel.hidden=true;return;}
      const targetY=listTop+Math.max(centers[0],Math.min(centers.at(-1)!,readingPosition));
      // Find the point at the reading height on the actual rendered curve.
      // The SVG stretches with each step, so a linear Y translation would drift.
      let low=0, high=path.getTotalLength();
      for(let iteration=0;iteration<16;iteration++){
        const middle=(low+high)/2;
        const point=path.getPointAtLength(middle).matrixTransform(matrix);
        if(point.y<targetY)low=middle;else high=middle;
      }
      const point=path.getPointAtLength((low+high)/2).matrixTransform(matrix);
      const bounds=route.getBoundingClientRect();
      // Direct progress feedback only: no autonomous animation or easing.
      vessel.hidden=false;
      vessel.style.transform=`translate3d(${point.x-bounds.left}px, ${point.y-bounds.top}px, 0) translate(-50%, -50%)`;
    }
    function schedule(){if(!scheduled&&visible){scheduled=true;requestAnimationFrame(update);}}
    new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;if(visible)schedule();},{rootMargin:'150px'}).observe(journey);
    new ResizeObserver(schedule).observe(list);
    new ResizeObserver(schedule).observe(document.body);
    window.addEventListener('scroll',schedule,{passive:true});
    window.addEventListener('resize',schedule,{passive:true});
    document.fonts.ready.then(schedule);
    update();
  }
</script>
