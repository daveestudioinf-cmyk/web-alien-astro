---
import SectionMarker from './SectionMarker.astro';
import { ArrowUpRight } from 'lucide-astro';
import { copy,cta } from '../lib/home';
import ClientBlocks from './ClientBlocks.astro';
const blocks=copy(11);
const paragraphs=blocks.filter(b=>b.type==='paragraph');
---
<section id="contacto" class="section final-cta">
  <SectionMarker index="10" />
  <div class="container cta-inner">
    <div>
      <span class="eyebrow">Alien Creativo · Marketing de Verdad.</span>
      <h2>{blocks[0].text}</h2>
      <ClientBlocks blocks={paragraphs.slice(0,2)} />
      <div class="hero-actions">
        <a class="button button-primary" href="#diagnostico">{cta(blocks,'CTA principal')} <ArrowUpRight size={17} /></a>
        <a class="text-link" href="https://wa.me/573053552822" target="_blank" rel="noopener noreferrer">{cta(blocks,'CTA secundario')} <ArrowUpRight size={16} /></a>
      </div>
      <p class="hero-note">{paragraphs[2].text}</p>
    </div>
    <div class="brand-contact-art" aria-hidden="true"><span class="brand-art-ring"></span><img src="/assets/brand/v3/alien-contact.webp" alt="" width="1024" height="1024" loading="lazy" /><img class="contact-signature" src="/assets/brand/v3/alien-symbol.svg" alt="" width="32" height="45" loading="lazy" /></div>
  </div>
</section>
